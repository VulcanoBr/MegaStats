<div class="mx-auto max-w-5xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">
  <h1 class="text-3xl font-bold text-white">
    Combinações menos frequentes
  </h1>

  <p class="text-sm text-slate-400">
    Ranking limitado às combinações que apareceram pelo menos uma vez
    no histórico importado.
  </p>

  <div class="space-y-4">
    <% @combinations.each_with_index do |item, index| %>
      <article class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-800 bg-slate-900 p-5">
        <div>
          <p class="text-sm text-slate-400">Posição <%= index + 1 %></p>

          <div class="mt-3 flex flex-wrap gap-2">
            <% item[:numbers].each do |number| %>
              <span class="flex size-10 items-center justify-center rounded-full bg-slate-800 font-bold text-white">
                <%= "%02d" % number %>
              </span>
            <% end %>
          </div>
        </div>

        <p class="text-sm text-slate-300">
          Ocorrências:
          <strong class="text-white"><%= item[:historical_occurrences] %></strong>
        </p>
      </article>
    <% end %>
  </div>

  <%= link_to "Voltar",
              combination_analyses_path,
              class: "inline-block text-lime-400 hover:text-lime-300" %>
</div>