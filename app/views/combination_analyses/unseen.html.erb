<div class="mx-auto max-w-5xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">
  <h1 class="text-3xl font-bold text-white">
    Cinco combinações inéditas
  </h1>

  <p class="text-sm text-slate-400">
    São combinações ausentes do histórico atualmente importado.
    Isso não aumenta a chance matemática de serem sorteadas.
  </p>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @combinations.each_with_index do |numbers, index| %>
      <article class="rounded-2xl border border-slate-800 bg-slate-900 p-5">
        <p class="text-sm text-slate-400">Combinação <%= index + 1 %></p>

        <div class="mt-4 flex flex-wrap gap-2">
          <% numbers.each do |number| %>
            <span class="flex size-10 items-center justify-center rounded-full bg-lime-400 font-bold text-slate-950">
              <%= "%02d" % number %>
            </span>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>

  <%= link_to "Voltar",
              combination_analyses_path,
              class: "inline-block text-lime-400 hover:text-lime-300" %>
</div>