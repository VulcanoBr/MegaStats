<div class="mx-auto max-w-7xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">
  <header>
    <h1 class="text-3xl font-bold text-white">
      Frequência dos números
    </h1>
    <p class="mt-2 text-sm text-slate-400">
      Consulte o histórico completo ou selecione os últimos concursos.
    </p>
  </header>

  <%= form_with url: number_analyses_path,
                method: :get,
                class: "flex flex-wrap items-end gap-4 rounded-2xl border border-slate-800 bg-slate-900 p-5" do |form| %>
    <div>
      <%= form.label :period, "Período",
                     class: "mb-2 block text-sm text-slate-300" %>

      <%= form.select :period,
                      [["Histórico completo", "all"],
                       ["Últimos 10 concursos", "10"],
                       ["Últimos 20 concursos", "20"],
                       ["Últimos 30 concursos", "30"]],
                      { selected: @period },
                      class: "rounded-lg border border-slate-700 bg-slate-950 px-4 py-2 text-white" %>
    </div>

    <%= form.submit "Aplicar filtro",
                    class: "rounded-lg bg-lime-400 px-5 py-2 font-semibold text-slate-950 hover:bg-lime-300" %>
  <% end %>

  <div class="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-900">
    <table class="min-w-full text-left text-sm">
      <thead class="text-slate-400">
        <tr>
          <th class="px-4 py-3">Posição</th>
          <th class="px-4 py-3">Número</th>
          <th class="px-4 py-3">Ocorrências</th>
          <th class="px-4 py-3">% dos concursos</th>
        </tr>
      </thead>

      <tbody class="divide-y divide-slate-800 text-white">
        <% @frequencies.each_with_index do |item, index| %>
          <tr>
            <td class="px-4 py-3"><%= index + 1 %></td>
            <td class="px-4 py-3 font-semibold"><%= "%02d" % item[:number] %></td>
            <td class="px-4 py-3"><%= item[:count] %></td>
            <td class="px-4 py-3"><%= number_to_percentage(item[:percentage], precision: 2) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>