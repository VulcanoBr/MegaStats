
<div class="mx-auto max-w-5xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">

  <header>
    <%= link_to "← Histórico de importações",
                import_batches_path,
                class: "text-sm text-lime-400 hover:text-lime-300" %>

    <h1 class="mt-4 text-3xl font-bold text-white">
      Importar histórico da Mega-Sena
    </h1>

    <p class="mt-2 text-sm text-slate-400">
      Selecione a planilha oficial da Caixa Econômica Federal
      para atualizar a base histórica do MegaStats.
    </p>
  </header>

  <section class="rounded-2xl border border-slate-800 bg-slate-900 p-6">

    <div class="mb-6 flex items-start gap-4">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center
                  rounded-xl bg-lime-400/10 text-2xl text-lime-400">
        ⇧
      </div>

      <div>
        <h2 class="font-semibold text-white">
          Selecionar planilha XLSX
        </h2>

        <p class="mt-1 text-sm text-slate-400">
          O arquivo deverá conter a aba MEGA SENA e o histórico
          completo dos concursos.
        </p>
      </div>
    </div>

    <%= form_with url: import_batches_path,
                  method: :post,
                  multipart: true,
                  class: "space-y-6" do |form| %>

      <div>
        <%= form.label :file,
                       "Arquivo oficial da Mega-Sena",
                       class: "mb-2 block text-sm font-medium text-slate-300" %>

        <%= form.file_field :file,
                            accept: ".xlsx",
                            required: true,
                            class: "block w-full cursor-pointer rounded-xl
                                    border border-slate-700 bg-slate-950
                                    p-3 text-sm text-slate-300
                                    file:mr-4 file:rounded-lg
                                    file:border-0 file:bg-lime-400
                                    file:px-4 file:py-2
                                    file:font-semibold file:text-slate-950
                                    hover:file:bg-lime-300" %>

        <p class="mt-2 text-xs text-slate-500">
          Formato permitido: XLSX. Tamanho máximo: 10 MB.
        </p>
      </div>

      <div class="rounded-xl border border-amber-900/60
                  bg-amber-950/20 p-4">

        <h3 class="font-semibold text-amber-300">
          Cuidados durante a importação
        </h3>

        <ul class="mt-3 list-inside list-disc space-y-2
                   text-sm text-slate-300">
          <li>O histórico existente não será apagado.</li>
          <li>Os registros serão preservados para auditoria.</li>
          <li>Planilhas inválidas deverão ser rejeitadas integralmente.</li>
          <li>Divergências em concursos existentes deverão ser identificadas.</li>
        </ul>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <%= form.submit "Enviar planilha",
                        class: "rounded-xl bg-lime-400 px-6 py-3
                                text-sm font-bold text-slate-950
                                transition hover:bg-lime-300" %>

        <%= link_to "Cancelar",
                    import_batches_path,
                    class: "rounded-xl border border-slate-700
                            px-6 py-3 text-sm font-medium
                            text-slate-300 hover:bg-slate-800" %>
      </div>

    <% end %>
  </section>
</div>
