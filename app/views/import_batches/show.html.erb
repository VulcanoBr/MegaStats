<div class="mx-auto max-w-5xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">
  <header>
    <%= link_to "← Histórico de importações",
                import_batches_path,
                class: "text-sm text-lime-400 hover:text-lime-300" %>

    <h1 class="mt-4 text-3xl font-bold text-white">
      Detalhes da importação
    </h1>
  </header>

  <section class="rounded-2xl border border-slate-800 bg-slate-900 p-6">
    <dl class="grid gap-5 sm:grid-cols-2">
      <% {
        "Arquivo" => @import_batch.file_name,
        "Status" => @import_batch.status,
        "Assinatura SHA-256" => @import_batch.file_sha256,
        "Linhas processadas" => @import_batch.total_rows,
        "Inseridos" => @import_batch.inserted_rows,
        "Atualizados" => @import_batch.updated_rows,
        "Ignorados" => @import_batch.skipped_rows,
        "Erros" => @import_batch.error_rows
      }.each do |label, value| %>
        <div>
          <dt class="text-sm text-slate-400"><%= label %></dt>
          <dd class="mt-1 break-words font-medium text-white">
            <%= value.presence || "—" %>
          </dd>
        </div>
      <% end %>
    </dl>
  </section>

  <% if @import_batch.error_details.present? %>
    <section class="rounded-2xl border border-rose-900 bg-slate-900 p-6">
      <h2 class="text-lg font-semibold text-white">Erros registrados</h2>

      <pre class="mt-4 overflow-x-auto whitespace-pre-wrap text-sm text-rose-200"><%= JSON.pretty_generate(@import_batch.error_details) %></pre>
    </section>
  <% end %>


  <% validation = @import_batch.validation_report || {} %>

  <% if validation.present? %>
    <section class="rounded-2xl border border-slate-800 bg-slate-900 p-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-lg font-semibold text-white">
          Auditoria do histórico
        </h2>

        <% validation_status = validation["status"] || validation[:status] %>

        <% status_styles = {
          "passed" => "bg-lime-400/10 text-lime-300",
          "warning" => "bg-amber-400/10 text-amber-300",
          "failed" => "bg-rose-400/10 text-rose-300"
        } %>

        <span class="rounded-full px-3 py-1 text-xs font-semibold
                    <%= status_styles.fetch(validation_status, 'bg-slate-700 text-slate-200') %>">
          <%= validation_status || "Não informado" %>
        </span>
      </div>

      <dl class="mt-5 grid gap-4 sm:grid-cols-2">
        <div>
          <dt class="text-sm text-slate-400">Concursos verificados</dt>
          <dd class="mt-1 font-semibold text-white">
            <%= validation["total_draws"] || validation[:total_draws] || 0 %>
          </dd>
        </div>

        <div>
          <dt class="text-sm text-slate-400">Data da auditoria</dt>
          <dd class="mt-1 font-semibold text-white">
            <%= validation["checked_at"] || validation[:checked_at] || "—" %>
          </dd>
        </div>
      </dl>

      <% errors = validation["errors"] || validation[:errors] || [] %>
      <% warnings = validation["warnings"] || validation[:warnings] || [] %>

      <% if errors.any? %>
        <div class="mt-6">
          <h3 class="font-semibold text-rose-300">
            Erros encontrados (<%= errors.size %>)
          </h3>

          <div class="mt-3 space-y-2">
            <% errors.each do |issue| %>
              <div class="rounded-lg border border-rose-900/70 bg-rose-950/20 p-3 text-sm">
                <p class="font-medium text-rose-200">
                  Concurso <%= issue["contest_number"] || issue[:contest_number] || "—" %>
                  · <%= issue["code"] || issue[:code] %>
                </p>
                <p class="mt-1 text-rose-200/80">
                  <%= issue["message"] || issue[:message] %>
                </p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if warnings.any? %>
        <div class="mt-6">
          <h3 class="font-semibold text-amber-300">
            Avisos encontrados (<%= warnings.size %>)
          </h3>

          <div class="mt-3 space-y-2">
            <% warnings.each do |issue| %>
              <div class="rounded-lg border border-amber-900/70 bg-amber-950/20 p-3 text-sm">
                <p class="font-medium text-amber-200">
                  Concurso <%= issue["contest_number"] || issue[:contest_number] || "—" %>
                  · <%= issue["code"] || issue[:code] %>
                </p>
                <p class="mt-1 text-amber-200/80">
                  <%= issue["message"] || issue[:message] %>
                </p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if errors.empty? && warnings.empty? %>
        <p class="mt-5 text-sm text-lime-300">
          Nenhum erro ou aviso encontrado na auditoria.
        </p>
      <% end %>
    </section>
  <% end %>


</div>