
<div class="mx-auto max-w-7xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">

  <header>
    <div class="flex items-center gap-3">
      <span class="flex size-12 items-center justify-center rounded-xl bg-lime-400/10 text-2xl text-lime-300">
        $
      </span>

      <div>
        <h1 class="text-3xl font-bold text-white">
          Análise por arrecadação
        </h1>

        <p class="mt-1 text-sm text-slate-400">
          Explore a frequência das dezenas conforme a arrecadação
          dos concursos da Mega-Sena.
        </p>
      </div>
    </div>
  </header>

  <% if flash.now[:alert].present? %>
    <div class="rounded-xl border border-rose-800 bg-rose-950/60 p-4 text-sm text-rose-200">
      <%= flash.now[:alert] %>
    </div>
  <% end %>

  <%# Navegação %>
  <nav class="border-b border-slate-800">
    <div class="flex gap-2 overflow-x-auto">

      <% tabs = [
        ["overview", "Visão geral"],
        ["ranges", "Frequência por faixa"],
        ["rankings", "Rankings"],
        ["custom", "Análise personalizada"]
      ] %>

      <% tabs.each do |key, label| %>
        <%= link_to label,
                    revenue_analyses_path(
                      tab: key,
                      minimum: @minimum,
                      maximum: @maximum
                    ),
                    aria: {
                      current: @active_tab == key ? "page" : nil
                    },
                    class: [
                      "shrink-0 border-b-2 px-4 py-3 text-sm font-medium transition",
                      @active_tab == key ?
                        "border-lime-400 text-lime-300" :
                        "border-transparent text-slate-400 hover:border-slate-600 hover:text-white"
                    ].join(" ") %>
      <% end %>

    </div>
  </nav>

  <%# Conteúdo da aba selecionada %>
  <%= render "revenue_analyses/tabs/#{@active_tab}" %>

  <p class="border-t border-slate-800 pt-4 text-xs leading-5 text-slate-500">
    As análises são estatísticas descritivas do histórico de concursos.
    Frequências e variações observadas não permitem prever os próximos sorteios.
  </p>

</div>
