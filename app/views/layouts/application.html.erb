
<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "MegaStats" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="MegaStats">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application",
          "data-turbo-track": "reload",
          type: "module" %>
  </head>

  <body class="min-h-screen bg-slate-950 text-white">
    <% flash.each do |type, message| %>
      <% next if message.blank? %>

      <% styles = {
        notice: "border-lime-500 bg-lime-950/40 text-lime-200",
        alert: "border-rose-500 bg-rose-950/40 text-rose-200",
        warning: "border-amber-500 bg-amber-950/40 text-amber-200"
      } %>

      <div class="mx-auto mt-4 max-w-5xl rounded-xl border-l-4 px-5 py-4 text-sm
                  <%= styles.fetch(type.to_sym, 'border-slate-500 bg-slate-900 text-slate-200') %>"
          role="status">
        <%= message %>
      </div>
    <% end %>
    <div class="mx-auto grid min-h-screen max-w-[1800px] grid-cols-1 gap-6 px-4 py-6 sm:px-6 lg:grid-cols-[250px_minmax(0,1fr)] lg:gap-8 lg:px-8">

      <%= render "shared/statistics_sidebar" %>

      <main class="min-w-0">
        <%= yield %>
      </main>

    </div>
  </body>
</html>
