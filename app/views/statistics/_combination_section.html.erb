
<section id="<%= id %>" class="mb-10 scroll-mt-6">
  <div class="mb-4">
    <h2 class="text-xl font-bold text-white"><%= title %></h2>
    <p class="mt-1 text-sm text-slate-400"><%= description %></p>
  </div>

  <% if analysis.present? %>
    <div class="mb-5 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3">
      <%= render "metric_cards", metrics: analysis[:metrics] || {} %>
    </div>

    <% [
      [:pairs, "Pares recorrentes"],
      [:triples, "Trincas recorrentes"],
      [:complete_combinations, "Combinações completas recorrentes"]
    ].each do |key, heading| %>

      <% group = analysis[key] %>

      <div class="mb-5 overflow-hidden rounded-2xl border border-slate-800 bg-slate-900">
        <div class="flex flex-col gap-1 border-b border-slate-800 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
          <h3 class="font-semibold text-white"><%= heading %></h3>

          <span class="text-xs text-slate-400">
            <%= number_with_delimiter(group[:distinct_observed]) %>
            combinações observadas
          </span>
        </div>

        <% if group[:recurrent].present? %>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[420px] text-left text-sm">
              <thead class="bg-slate-950/60 text-xs uppercase tracking-wide text-slate-500">
                <tr>
                  <th class="px-5 py-3">Dezenas</th>
                  <th class="px-5 py-3 text-right">Ocorrências</th>
                  <th class="px-5 py-3 text-right">Percentual</th>
                </tr>
              </thead>

              <tbody class="divide-y divide-slate-800">
                <% group[:recurrent].first(15).each do |item| %>
                  <tr class="hover:bg-slate-800/50">
                    <td class="px-5 py-3 font-semibold text-white">
                      <%= item[:numbers].map { |number| format("%02d", number) }.join(" - ") %>
                    </td>

                    <td class="px-5 py-3 text-right tabular-nums text-slate-300">
                      <%= number_with_delimiter(item[:occurrence_count]) %>
                    </td>

                    <td class="px-5 py-3 text-right tabular-nums text-slate-300">
                      <%= number_to_percentage(item[:percentage], precision: 2) %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="p-5 text-sm text-slate-400">
            Nenhuma combinação recorrente encontrada.
          </p>
        <% end %>
      </div>
    <% end %>

    <% consecutive = analysis[:consecutive_draws] %>

    <div class="mb-5 overflow-hidden rounded-2xl border border-slate-800 bg-slate-900">
      <div class="border-b border-slate-800 px-5 py-4">
        <h3 class="font-semibold text-white">
          Repetição entre concursos consecutivos
        </h3>
        <p class="mt-1 text-xs text-slate-400">
          Quantidade de dezenas que aparecem nos dois concursos da transição.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3 p-5 sm:grid-cols-3 xl:grid-cols-4">
        <% consecutive[:distribution].each do |item| %>
          <div class="rounded-xl border border-slate-800 bg-slate-950/50 p-4">
            <p class="text-xs text-slate-400">
              <%= item[:repeated_count] %> repetidas
            </p>

            <p class="mt-2 text-xl font-bold tabular-nums text-white">
              <%= number_with_delimiter(item[:transition_count]) %>
            </p>

            <p class="mt-1 text-xs text-slate-500">
              <%= number_to_percentage(item[:percentage], precision: 2) %>
            </p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="overflow-hidden rounded-2xl border border-slate-800 bg-slate-900">
      <div class="border-b border-slate-800 px-5 py-4">
        <h3 class="font-semibold text-white">
          Transições com maior repetição
        </h3>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full min-w-[500px] text-left text-sm">
          <thead class="bg-slate-950/60 text-xs uppercase tracking-wide text-slate-500">
            <tr>
              <th class="px-5 py-3">Concurso anterior</th>
              <th class="px-5 py-3">Concurso atual</th>
              <th class="px-5 py-3 text-right">Repetições</th>
              <th class="px-5 py-3">Dezenas repetidas</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-800">
            <% analysis[:rankings][:most_repeated_between_consecutive_draws].first(15).each do |item| %>
              <tr class="hover:bg-slate-800/50">
                <td class="px-5 py-3 text-slate-300">
                  <%= item[:previous_contest] %>
                </td>

                <td class="px-5 py-3 text-slate-300">
                  <%= item[:current_contest] %>
                </td>

                <td class="px-5 py-3 text-right font-semibold tabular-nums text-white">
                  <%= item[:repeated_count] %>
                </td>

                <td class="px-5 py-3 text-slate-300">
                  <%= item[:repeated_numbers].map { |number| format("%02d", number) }.join(", ").presence || "Nenhuma" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <p class="rounded-xl border border-slate-800 bg-slate-900 p-5 text-sm text-slate-400">
      Não existem resultados disponíveis para esta análise.
    </p>
  <% end %>
</section>
