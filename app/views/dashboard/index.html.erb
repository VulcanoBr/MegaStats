<div class="mx-auto max-w-7xl space-y-8 px-4 py-8 sm:px-6 lg:px-8">
  <header>
    <p class="text-sm font-semibold uppercase tracking-widest text-lime-400">
      MegaStats
    </p>

    <h1 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
      Análise histórica da Mega-Sena
    </h1>

    <p class="mt-3 max-w-2xl text-sm text-slate-400">
      Frequências, tendências históricas e combinações matemáticas.
      As estatísticas descrevem o passado e não preveem resultados futuros.
    </p>

  </header>

  <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <article class="rounded-2xl border border-slate-800 bg-slate-900 p-6">
      <p class="text-sm text-slate-400">Concursos registrados</p>
      <p class="mt-3 text-3xl font-bold text-white">
        <%= number_with_delimiter(@total_draws, delimiter: ".") %>
      </p>
    </article>

    <article class="rounded-2xl border border-slate-800 bg-slate-900 p-6">
      <p class="text-sm text-slate-400">Primeiro concurso</p>
      <p class="mt-3 text-2xl font-bold text-white">
        <%= @first_draw&.contest_number || "—" %>
      </p>
      <p class="mt-2 text-sm text-slate-400">
        <%= l(@first_draw.draw_date) if @first_draw %>
      </p>
    </article>

    <article class="rounded-2xl border border-slate-800 bg-slate-900 p-6">
      <p class="text-sm text-slate-400">Último concurso</p>
      <p class="mt-3 text-2xl font-bold text-white">
        <%= @last_draw&.contest_number || "—" %>
      </p>
      <p class="mt-2 text-sm text-slate-400">
        <%= l(@last_draw.draw_date) if @last_draw %>
      </p>
    </article>
  </section>

  <section class="grid gap-6 lg:grid-cols-2">
    <article class="rounded-2xl border border-slate-800 bg-slate-900 p-6">
      <h2 class="text-xl font-semibold text-white">
        Números mais sorteados
      </h2>

      <div class="mt-5 space-y-4">
        <% @top_numbers.each do |item| %>
          <div>
            <div class="mb-2 flex items-center justify-between text-sm">
              <span class="font-semibold text-white">
                <%= "%02d" % item[:number] %>
              </span>

              <span class="text-slate-400">
                <%= item[:count] %> ocorrências
                (<%= number_to_percentage(item[:percentage], precision: 2) %>)
              </span>
            </div>

            <div class="h-2 overflow-hidden rounded-full bg-slate-800">
              <div
                class="h-full rounded-full bg-lime-400"
                style="width: <%= item[:count].fdiv([@top_numbers.first[:count], 1].max) * 100 %>%">
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </article>

    <article class="rounded-2xl border border-slate-800 bg-slate-900 p-6">
      <h2 class="text-xl font-semibold text-white">
        Números menos sorteados
      </h2>

      <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3">
        <% @least_numbers.each do |item| %>
          <div class="rounded-xl border border-slate-800 bg-slate-950 p-4">
            <p class="text-2xl font-bold text-white">
              <%= "%02d" % item[:number] %>
            </p>

            <p class="mt-1 text-sm text-slate-400">
              <%= item[:count] %> ocorrências
            </p>
          </div>
        <% end %>
      </div>
    </article>
  </section>
</div>